                <Baseline points="1824,1544 1850,1542 1876,1542 1903,1542 1929,1542 1956,1542 1982,1542 2009,1542 2035,1544 2061,1544 2088,1544 2114,1545 2141,1545 2167,1545 2194,1545 2220,1545 2247,1544" />
                <TextEquiv>
