                <Coords points="194,3200 553,3209 554,3176 500,3154 482,3169 387,3157 368,3172 340,3154 316,3169 231,3153 195,3163" />
                <Baseline points="206,3189 231,3191 257,3192 283,3194 309,3194 335,3194 361,3194 387,3194 413,3194 439,3194 465,3194 491,3194 517,3195 543,3197" />
