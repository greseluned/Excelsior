                <Coords points="324,1701 407,1701 490,1701 573,1702 657,1702 740,1702 823,1702 906,1702 990,1702 1073,1701 1156,1701 1239,1701 1323,1701 1406,1701 1489,1701 1572,1701 1656,1699 1739,1699 1822,1701 1905,1701 1989,1701 1989,1671 1905,1671 1822,1671 1739,1669 1656,1669 1572,1671 1489,1671 1406,1671 1323,1671 1239,1671 1156,1671 1073,1671 990,1672 906,1672 823,1672 740,1672 657,1672 573,1672 490,1671 407,1671 324,1671" />
